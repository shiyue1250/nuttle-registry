  "platforms": [
    {
      "id": "weixin",
      "letter": "微",
      "group": "main",
      "name": {
        "zh": "微信",
        "en": "WeChat"
      },
      "desc": {
        "zh": "公众号文章、视频号、聊天与群聊、收藏，按需开启。",
        "en": "Official Account articles, Channels, chats and Favorites — turn on what you need."
      },
      "parts": [
        {
          "id": "mp",
          "packs": [
            "weixin-mp"
          ],
          "plugins": [
            "nuttle.wechat-mp"
          ],
          "name": {
            "zh": "公众号文章",
            "en": "Official Account articles"
          },
          "desc": {
            "zh": "记录打开过的公众号文章：标题、公众号、作者、发布时间、正文；正文配图可下载。",
            "en": "Records the Official Account articles you open: title, account, author, time and full text; images can be downloaded."
          }
        },
        {
          "id": "channels",
          "packs": [
            "weixin"
          ],
          "plugins": [
            "official.wechat",
            "nuttle.wechat-extra"
          ],
          "name": {
            "zh": "视频号",
            "en": "Channels"
          },
          "desc": {
            "zh": "采集视频号的视频、作者、互动数据与评论，以及带货助手的选品商品。",
            "en": "Collects Channels videos, authors, engagement and comments, plus products from the shopping assistant."
          }
        },
        {
          "id": "chats",
          "packs": [
            "wechat-local"
          ],
          "local": "wechat-local",
          "scope": "chats",
          "name": {
            "zh": "聊天与群聊",
            "en": "Chats and groups"
          },
          "desc": {
            "zh": "列出会话，选中的会话才读取消息。",
            "en": "Lists your chats; messages are read only for the chats you pick."
          },
          "risk": {
            "zh": "通过读取本机的微信数据库获取（只读，不改动微信）。",
            "en": "Read from the WeChat database on this computer (read-only; WeChat itself is untouched)."
          }
        },
        {
          "id": "favorites",
          "packs": [
            "wechat-local"
          ],
          "local": "wechat-local",
          "scope": "favorites",
          "name": {
            "zh": "收藏",
            "en": "Favorites"
          },
          "desc": {
            "zh": "点「读入收藏」时读取微信收藏。",
            "en": "Reads your WeChat Favorites when you click Read Favorites."
          },
          "risk": {
            "zh": "通过读取本机的微信数据库获取（只读，不改动微信）。",
            "en": "Read from the WeChat database on this computer (read-only; WeChat itself is untouched)."
          }
        },
        {
          "id": "export",
          "packs": [
            "wechat-chat"
          ],
          "local": "wechat-chat",
          "name": {
            "zh": "导入导出的聊天记录",
            "en": "Import exported chats"
          },
          "desc": {
            "zh": "在微信里多选消息 → 转发 → 其他应用，导出后导入。只读你导出的文件。",
            "en": "In WeChat, select messages → Forward → Other apps, then import the export. Only reads the file you export."
          }
        }
      ]
    },
    {
      "id": "feishu",
      "letter": "飞",
      "group": "main",
      "name": {
        "zh": "飞书",
