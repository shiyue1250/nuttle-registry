{
  "apiVersion": 1,
  "id": "mail",
  "version": "0.1.0",
  "label": "邮箱",
  "locales": {
    "zh": {
      "name": "邮箱"
    },
    "en": {
      "name": "Mail"
    }
  },
  "hosts": [],
  "endpoints": [
    {
      "match": "/nuttle/mail/messages",
      "label": "各账户的邮件（经 IMAP 同步，已内置解析）"
    }
  ],
  "connector": {
    "kind": "imap",
    "folders": [
      "INBOX"
    ],
    "providers": [
      {
        "id": "qq",
        "name": "QQ 邮箱",
        "domains": [
          "qq.com",
          "foxmail.com",
          "vip.qq.com"
        ],
        "host": "imap.qq.com",
        "port": 993,
        "secret_label": "授权码",
        "help": "在 QQ 邮箱网页版：设置 → 账号 → 开启「IMAP/SMTP 服务」，按提示生成授权码，填在这里（不是 QQ 密码）。"
      },
      {
        "id": "163",
        "name": "网易 163 邮箱",
        "domains": [
          "163.com"
        ],
        "host": "imap.163.com",
        "port": 993,
        "secret_label": "授权码",
        "help": "在 163 邮箱网页版：设置 → POP3/SMTP/IMAP → 开启「IMAP/SMTP 服务」，按提示生成授权码，填在这里（不是登录密码）。"
      },
      {
        "id": "126",
        "name": "网易 126 邮箱",
        "domains": [
          "126.com"
        ],
        "host": "imap.126.com",
        "port": 993,
        "secret_label": "授权码",
        "help": "在 126 邮箱网页版：设置 → POP3/SMTP/IMAP → 开启「IMAP/SMTP 服务」，按提示生成授权码，填在这里（不是登录密码）。"
      },
      {
        "id": "yeah",
        "name": "网易 yeah.net",
        "domains": [
          "yeah.net"
        ],
        "host": "imap.yeah.net",
        "port": 993,
        "secret_label": "授权码",
        "help": "在 yeah.net 邮箱网页版：设置 → POP3/SMTP/IMAP → 开启「IMAP/SMTP 服务」，按提示生成授权码，填在这里（不是登录密码）。"
      },
      {
        "id": "gmail",
        "name": "Gmail",
        "domains": [
          "gmail.com",
          "googlemail.com"
        ],
        "host": "imap.gmail.com",
        "port": 993,
        "secret_label": "应用专用密码",
        "help": "个人 Gmail：先在 Google 账号开启两步验证，再到「应用专用密码」生成一个，填在这里（不是登录密码）。公司或学校的 Google Workspace 账号只能用 OAuth 登录，目前不支持。"
      },
      {
        "id": "icloud",
        "name": "iCloud 邮件",
        "domains": [
          "icloud.com",
          "me.com",
          "mac.com"
        ],
        "host": "imap.mail.me.com",
        "port": 993,
        "secret_label": "App 专用密码",
        "help": "在 Apple 账户网站：登录与安全 → App 专用密码，生成一个填在这里（不是 Apple 账户密码）。"
      },
      {
        "id": "exmail",
        "name": "腾讯企业邮",
        "domains": [],
        "host": "imap.exmail.qq.com",
        "port": 993,
        "secret_label": "密码或客户端专用密码",
        "help": "企业邮管理员需允许 IMAP；开了安全登录（微信动态码）的账号，在企业邮网页版：设置 → 账户 → 客户端专用密码 生成一个。"
      },
      {
        "id": "aliyun-qiye",
        "name": "阿里企业邮箱",
        "domains": [],
        "host": "imap.qiye.aliyun.com",
        "port": 993,
        "secret_label": "密码或三方客户端安全密码",
        "help": "企业邮管理员需允许 IMAP；开了三方客户端安全密码的，在网页版设置里生成一个填在这里。"
      }
    ],
    "classify": [
      {
        "category": "personal",
        "own": true
      },
      {
        "category": "personal",
        "answered": true
      },
      {
        "category": "ad",
        "subject": [
          "(AD)",
          "（AD）",
          "[AD]",
          "【AD】",
          "(广告)",
          "（广告）",
          "[广告]",
          "【广告】",
          "<广告>",
          "＜广告＞"
        ]
      },
      {
        "category": "notification",
        "auto": true
      },
      {
        "category": "subscription",
        "list": true
      },
      {
        "category": "notification",
        "from": [
          "noreply",
          "no-reply",
          "no_reply",
          "donotreply",
          "do-not-reply",
          "mailer-daemon",
          "postmaster",
          "notification",
          "notify",
          "alert"
        ]
      },
      {
        "category": "subscription",
        "precedence": [
          "bulk",
          "list",
          "junk"
        ]
      }
    ]
  },
  "notes": "一个平台、多个账户。用户自选服务商（按地址后缀自动认）或「其他」自填服务器，用自己的授权码 / 应用专用密码经 IMAP（993，加密）只读同步所选文件夹：首次取最近 7 天，之后按编号增量；取信不改已读，不发信、不删信。附件 20MB 以内存到本机。由内置连接器 mail 交回 /nuttle/mail/messages（每封带 account），本包解析。"
}
