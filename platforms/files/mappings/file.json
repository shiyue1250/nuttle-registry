{
  "apiVersion": 1,
  "id": "files/file",
  "version": "0.1.0",
  "platform": "files",
  "entity": "file",
  "match": {
    "host": "files.local",
    "path": "/nuttle/files/files"
  },
  "item_path": "files",
  "fields": {
    "id": "id",
    "title": "name",
    "path": "path",
    "folder": "folder",
    "rel": "rel",
    "ext": "ext",
    "size": "size",
    "mtime": "mtime",
    "create_time": "mtime",
    "content": "text",
    "text_state": "text_state"
  },
  "schema": {
    "id": {
      "type": "string",
      "note": "完整路径的 SHA-256 前 24 位"
    },
    "path": {
      "type": "string",
      "note": "完整路径"
    },
    "folder": {
      "type": "string",
      "note": "用户选的那个文件夹"
    },
    "rel": {
      "type": "string",
      "note": "相对所选文件夹的路径"
    },
    "ext": {
      "type": "string",
      "note": "小写扩展名"
    },
    "size": {
      "type": "int",
      "note": "字节"
    },
    "mtime": {
      "type": "unix_s",
      "note": "修改时间；和大小一起判断要不要重读"
    },
    "create_time": {
      "type": "unix_s",
      "note": "同 mtime"
    },
    "content": {
      "type": "string",
      "note": "正文文字：txt / md / csv / json / html / docx / pptx / xlsx 等，超过 2 万字截断；其他类型为空"
    },
    "text_state": {
      "type": "string",
      "note": "ok 读出了文字 / unsupported 类型暂不支持（如 PDF、图片）/ too_large 超过 20MB / failed 读取失败"
    }
  },
  "trigger": "选了文件夹后每 10 分钟扫描一次",
  "fixture": "file.fixture.json",
  "verified": "2026-10-30",
  "author": "nuttle-mac",
  "license": "MIT",
  "note": "样本是按连接器的真实输出构造的示例值",
  "locales": {
    "zh": {
      "name": "文件",
      "description": "所选文件夹里的文件：名字、路径、大小、修改时间与正文文字"
    },
    "en": {
      "name": "File",
      "description": "Files in the folders you picked: name, path, size, modified time and text"
    }
  },
  "display": {
    "columns": [
      "title",
      "rel",
      "mtime",
      "text_state"
    ],
    "labels": {
      "zh": {
        "title": "文件名",
        "rel": "位置",
        "path": "完整路径",
        "folder": "所选文件夹",
        "ext": "类型",
        "size": "大小",
        "mtime": "修改时间",
        "content": "正文",
        "text_state": "文字"
      },
      "en": {
        "title": "Name",
        "rel": "Location",
        "path": "Full path",
        "folder": "Folder",
        "ext": "Type",
        "size": "Size",
        "mtime": "Modified",
        "content": "Text",
        "text_state": "Text"
      }
    }
  }
}
