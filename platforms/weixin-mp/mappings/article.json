{
  "apiVersion": 1,
  "id": "weixin-mp/article",
  "version": "0.2.3",
  "platform": "weixin-mp",
  "entity": "article",
  "match": {
    "host": "mp.weixin.qq.com",
    "path": "/nuttle/wechat-mp/articles"
  },
  "item_path": "articles",
  "fields": {
    "id": "id",
    "title": "title",
    "account": "account",
    "account_id": "account_id",
    "author": "author",
    "avatar": "avatar",
    "create_time": "create_time",
    "desc": "desc",
    "content": "content",
    "image_count": "image_count",
    "cover": "cover",
    "comment_id": "comment_id",
    "original": "original",
    "source_url": "source_url",
    "biz": "biz",
    "url": "url",
    "read_num": "read_num",
    "like_num": "like_num",
    "seen_num": "seen_num",
    "share_num": "share_num",
    "collect_num": "collect_num",
    "comment_count": "comment_count",
    "blocks": "blocks",
    "html": "html"
  },
  "schema": {
    "create_time": {
      "type": "unix_s"
    },
    "cover": {
      "type": "image"
    },
    "image_count": {
      "type": "int",
      "note": "正文配图张数"
    },
    "original": {
      "type": "bool",
      "note": "原创"
    },
    "content": {
      "type": "string",
      "note": "正文纯文本，按段落换行"
    },
    "comment_id": {
      "type": "string",
      "note": "留言区 id，留言接口按它关联文章"
    },
    "url": {
      "type": "url",
      "note": "原文链接"
    },
    "biz": {
      "type": "string",
      "note": "公众号 id（__biz）"
    },
    "read_num": {
      "type": "int",
      "note": "阅读数（10 万以上时微信只给 100001）"
    },
    "like_num": {
      "type": "int"
    },
    "seen_num": {
      "type": "int",
      "note": "「在看」（爱心）"
    },
    "share_num": {
      "type": "int"
    },
    "collect_num": {
      "type": "int"
    },
    "comment_count": {
      "type": "int"
    },
    "blocks": {
      "type": "json",
      "note": "正文按原文顺序的段落、插图、视频：[{t:\"p\"|\"img\"|\"video\", v, cover?}]，详情页据此还原排版；视频 v 是 wxv_ 编号，播放地址在资源里"
    },
    "html": {
      "type": "string",
      "note": "正文排版（精简过的 HTML：只留标签与 style、图片、视频标记），详情页按白名单过滤后原样显示；超过 600 KB 不存"
    }
  },
  "trigger": "在电脑版微信或浏览器里打开公众号文章（需要「公众号文章」插件）",
  "note": "文章页 HTML 由「公众号文章」插件整理；阅读 / 赞 / 在看 / 转发 / 收藏 / 留言数由插件的页面脚本在页面拿到时抄回，并进同一篇文章",
  "fixture": "article.fixture.json",
  "verified": "2026-10-07",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "公众号文章",
      "description": "打开过的每篇公众号文章：标题、公众号、作者、发布时间、摘要、正文、配图数、原创标记、原文链接"
    },
    "en": {
      "name": "Official Account articles",
      "description": "Every Official Account article you open: title, account, author, time, summary, full text, image count, original mark, link"
    }
  },
  "jsonld": {
    "@type": "Article",
    "map": {
      "title": "headline",
      "content": "articleBody",
      "author": "author",
      "create_time": "datePublished",
      "url": "url"
    }
  },
  "display": {
    "columns": [
      "cover",
      "title",
      "account",
      "create_time",
      "read_num",
      "like_num",
      "comment_count",
      "original"
    ],
    "labels": {
      "zh": {
        "cover": "封面",
        "title": "标题",
        "account": "公众号",
        "author": "作者",
        "create_time": "发布时间",
        "image_count": "配图",
        "original": "原创",
        "read_num": "阅读",
        "like_num": "赞",
        "seen_num": "在看",
        "share_num": "转发",
        "collect_num": "收藏",
        "comment_count": "留言"
      },
      "en": {
        "cover": "Cover",
        "title": "Title",
        "account": "Account",
        "author": "Author",
        "create_time": "Published",
        "image_count": "Images",
        "original": "Original",
        "read_num": "Reads",
        "like_num": "Likes",
        "seen_num": "Wow",
        "share_num": "Shares",
        "collect_num": "Saves",
        "comment_count": "Comments"
      }
    }
  },
  "resource": {
    "plugin": "nuttle.wechat-mp",
    "match": {
      "meta:wechatMp.articleId": "id"
    }
  }
}
