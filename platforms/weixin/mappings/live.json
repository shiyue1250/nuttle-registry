{
  "apiVersion": 1,
  "id": "weixin/live",
  "version": "0.1.1",
  "platform": "weixin",
  "entity": "live",
  "match": {
    "host": "wxapp.tc.qq.com",
    "path": "/nuttle/wxlive/Session"
  },
  "item_path": "",
  "fields": {
    "id": "liveId",
    "title": "title",
    "author": "anchor",
    "cover": "cover",
    "start": "start",
    "end": "end",
    "online_max": "online_max",
    "like_count": "likes",
    "audio_secs": "audio_secs",
    "recording": "recording",
    "products": "products"
  },
  "schema": {
    "cover": {
      "type": "image"
    },
    "start": {
      "type": "unix_s",
      "note": "开始看（开始记录）的时间；同一场退出再进接着记"
    },
    "end": {
      "type": "unix_s",
      "note": "最后一次记录的时间"
    },
    "online_max": {
      "type": "int",
      "note": "看的这段时间里最高在线人数"
    },
    "like_count": {
      "type": "int"
    },
    "audio_secs": {
      "type": "duration_s",
      "note": "录音时长；录音在数据目录 media/live/<直播编号>.aac"
    },
    "recording": {
      "type": "bool",
      "note": "还在记录"
    },
    "products": {
      "type": "json",
      "note": "讲解过 / 被下单的商品（直播间商品卡推送与下单消息）：[{id, title, img, price, market_price（元）, list_no（上架序号）, orders（下单次数）, spans（讲解时段 [[开始, 结束 | null]]，录音里的秒数，null = 还在讲）}]"
    }
  },
  "trigger": "平台页「微信 → 视频号直播」开着，在电脑版微信里进视频号直播间、在囤囤鼠侧栏点「开始记录」；暂停、离开直播间 90 秒内停止",
  "fixture": "live.fixture.json",
  "verified": "2026-11-02",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "视频号直播",
      "description": "记录过的每一场直播：主播、标题、看的时段、最高在线、点赞、录音、讲解过的商品；口播与评论挂在下面"
    },
    "en": {
      "name": "Channels live streams",
      "description": "Each live stream you recorded: host, title, when, peak viewers, likes, recording, products presented; speech and comments underneath"
    }
  },
  "display": {
    "columns": [
      "title",
      "author",
      "start",
      "audio_secs",
      "online_max",
      "like_count",
      "cover"
    ],
    "labels": {
      "zh": {
        "title": "标题",
        "author": "主播",
        "start": "开始",
        "audio_secs": "录音",
        "online_max": "最高在线",
        "like_count": "点赞",
        "cover": "封面"
      },
      "en": {
        "title": "Title",
        "author": "Host",
        "start": "Start",
        "audio_secs": "Recording",
        "online_max": "Peak viewers",
        "like_count": "Likes",
        "cover": "Cover"
      }
    }
  }
}
