{
  "apiVersion": 1,
  "id": "xiaohongshu/comment-page",
  "version": "0.2.2",
  "platform": "xiaohongshu",
  "entity": "comment",
  "match": {
    "host": "edith.xiaohongshu.com",
    "path": "/api/sns/web/v2/comment/page"
  },
  "item_path": "data.comments",
  "fields": {
    "id": "id",
    "note_id": "note_id",
    "content": "content",
    "like_count": "like_count",
    "create_time": "create_time/1000",
    "ip_location": "ip_location",
    "sub_comment_count": "sub_comment_count",
    "user_id": "user_info.user_id",
    "nickname": "user_info.nickname",
    "extra.sub_comments": "sub_comments",
    "extra.pictures": "pictures",
    "head": "user_info.image",
    "reply_count": "sub_comment_count",
    "url": "=https://www.xiaohongshu.com/explore/{note_id}?xsec_token={$q.xsec_token}&xsec_source=pc_comment"
  },
  "schema": {
    "like_count": {
      "type": "int",
      "note": "接口给的是字符串，如 \"12\""
    },
    "create_time": {
      "type": "unix_s",
      "note": "接口是毫秒，/1000 后为秒"
    },
    "sub_comment_count": {
      "type": "int",
      "note": "接口给的是字符串"
    },
    "note_id": {
      "type": "string",
      "note": "对应「小红书笔记」的 id"
    },
    "reply_count": {
      "type": "int",
      "note": "同 sub_comment_count，详情页用；可能是「10+」"
    },
    "url": {
      "type": "url",
      "note": "所在笔记的原文链接（带评论接口里的 xsec_token，小红书要它才让打开）"
    }
  },
  "fixture": "comment-page.fixture.json",
  "verified": "2026-10-05",
  "author": "shiyue1250",
  "license": "MIT",
  "trigger": "笔记详情页展开评论、点「更多评论」翻页",
  "pagination": {
    "has_more": "data.has_more",
    "cursor": "data.cursor"
  },
  "noise": [
    "/api/im/web/emoji/config",
    "/api/sec/v1/scripting"
  ],
  "locales": {
    "zh": {
      "name": "小红书评论",
      "description": "笔记详情页的评论列表，翻页时持续采集"
    },
    "en": {
      "name": "RedNote comments",
      "description": "Comments on a note page, collected as you page through them"
    }
  },
  "jsonld": {
    "@type": "Comment",
    "map": {
      "content": "text",
      "like_count": "upvoteCount",
      "create_time": "dateCreated",
      "nickname": "author"
    }
  },
  "display": {
    "columns": [
      "content",
      "nickname",
      "like_count",
      "sub_comment_count",
      "ip_location",
      "create_time",
      "note_id"
    ],
    "labels": {
      "zh": {
        "content": "评论",
        "nickname": "评论者",
        "like_count": "点赞",
        "sub_comment_count": "回复数",
        "ip_location": "IP 属地",
        "create_time": "时间",
        "note_id": "笔记 id"
      },
      "en": {
        "content": "Comment",
        "nickname": "By",
        "like_count": "Likes",
        "sub_comment_count": "Replies",
        "ip_location": "IP region",
        "create_time": "Time",
        "note_id": "Note id"
      }
    }
  },
  "relations": {
    "parent": {
      "card": "xiaohongshu/note",
      "field": "note_id",
      "count_field": "comment_count"
    },
    "replies": "sub_comments",
    "reply_fields": {
      "id": "id",
      "nickname": "user_info.nickname",
      "content": "content",
      "like_count": "like_count",
      "create_time": "create_time/1000",
      "ip_location": "ip_location",
      "head": "user_info.image",
      "reply_to": "target_comment.id",
      "reply_to_nickname": "target_comment.user_info.nickname"
    }
  }
}
