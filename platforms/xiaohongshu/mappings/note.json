{
  "apiVersion": 1,
  "id": "xiaohongshu/note",
  "version": "0.2.0",
  "platform": "xiaohongshu",
  "entity": "note",
  "match": {
    "host": "edith.xiaohongshu.com",
    "path": "/api/sns/web/v1/feed"
  },
  "item_path": "data.items",
  "fields": {
    "id": "id",
    "title": "note_card.title",
    "content": "note_card.desc",
    "author": "note_card.user.nickname",
    "author_id": "note_card.user.user_id",
    "note_type": "note_card.type",
    "create_time": "note_card.time/1000",
    "ip_location": "note_card.ip_location",
    "like_count": "note_card.interact_info.liked_count",
    "collect_count": "note_card.interact_info.collected_count",
    "comment_count": "note_card.interact_info.comment_count",
    "share_count": "note_card.interact_info.share_count",
    "cover": "note_card.image_list.0.url_default",
    "extra.images": "note_card.image_list",
    "extra.tags": "note_card.tag_list",
    "extra.avatar": "note_card.user.avatar",
    "extra.video": "note_card.video"
  },
  "schema": {
    "create_time": {
      "type": "unix_s",
      "note": "接口是毫秒，/1000 后为秒"
    },
    "note_type": {
      "type": "string",
      "note": "normal = 图文，video = 视频"
    },
    "like_count": {
      "type": "int",
      "note": "接口给的是字符串"
    },
    "collect_count": {
      "type": "int",
      "note": "接口给的是字符串"
    },
    "comment_count": {
      "type": "int",
      "note": "接口给的是字符串"
    },
    "share_count": {
      "type": "int",
      "note": "接口给的是字符串"
    },
    "cover": {
      "type": "image",
      "note": "第一张图"
    },
    "title": {
      "type": "string",
      "note": "不少笔记没有标题，只有正文"
    }
  },
  "trigger": "在小红书网页版点开笔记详情（游客也可以）",
  "note": "正文里的话题写作 #话题[话题]#，原样保留",
  "fixture": "note.fixture.json",
  "verified": "2026-10-05",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "小红书笔记",
      "description": "点开的每篇笔记：标题、正文、作者、发布时间、IP 属地、点赞 / 收藏 / 评论 / 分享数、图片与话题"
    },
    "en": {
      "name": "RedNote notes",
      "description": "Every note you open: title, text, author, time, IP region, likes / saves / comments / shares, images and topics"
    }
  },
  "jsonld": {
    "@type": "SocialMediaPosting",
    "map": {
      "title": "headline",
      "content": "articleBody",
      "author": "author",
      "create_time": "datePublished"
    }
  },
  "display": {
    "columns": [
      "cover",
      "title",
      "content",
      "author",
      "create_time",
      "like_count",
      "collect_count",
      "comment_count",
      "share_count",
      "ip_location",
      "note_type"
    ],
    "labels": {
      "zh": {
        "cover": "封面",
        "title": "标题",
        "content": "正文",
        "author": "作者",
        "create_time": "发布时间",
        "like_count": "点赞",
        "collect_count": "收藏",
        "comment_count": "评论",
        "share_count": "分享",
        "ip_location": "IP 属地",
        "note_type": "类型"
      },
      "en": {
        "cover": "Cover",
        "title": "Title",
        "content": "Text",
        "author": "Author",
        "create_time": "Posted",
        "like_count": "Likes",
        "collect_count": "Saves",
        "comment_count": "Comments",
        "share_count": "Shares",
        "ip_location": "IP region",
        "note_type": "Type"
      }
    }
  },
  "resource": {
    "plugin": "official.xiaohongshu",
    "match": {
      "meta:xiaohongshu.noteId": "id"
    },
    "kinds": [
      "media.video"
    ]
  }
}
