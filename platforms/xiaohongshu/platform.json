{
  "apiVersion": 1,
  "id": "xiaohongshu",
  "version": "0.5.1",
  "label": "小红书",
  "locales": {
    "zh": {
      "name": "小红书"
    },
    "en": {
      "name": "Xiaohongshu (RED)"
    }
  },
  "hosts": [
    "*.xiaohongshu.com"
  ],
  "watches": [
    "/api/sns/web/v1/feed",
    "/api/sns/web/v2/comment/page",
    "/api/sns/web/v2/comment/sub/page",
    "/_dom/__INITIAL_STATE__",
    "/api/sns/web/v2/search/notes",
    "/api/sns/web/v1/homefeed"
  ],
  "noise": [
    "/api/im/web/emoji/config",
    "/api/sec/v1/scripting",
    "/api/im/"
  ],
  "endpoints": [
    {
      "match": "/api/sns/web/v1/homefeed",
      "label": "首页推荐流（标题、封面、作者、点赞数、原文链接）"
    },
    {
      "match": "/api/sns/web/v2/search/notes",
      "label": "搜索结果列表（标题、封面、作者、互动数、原文链接）"
    },
    {
      "match": "/api/sns/web/v1/feed",
      "label": "笔记详情（正文、图片、互动数据）"
    },
    {
      "match": "/_dom/__INITIAL_STATE__",
      "label": "直接打开的笔记页内嵌数据（正文、图片、互动数据）"
    },
    {
      "match": "/api/sns/web/v2/comment/page",
      "label": "笔记评论分页（已有映射卡）"
    },
    {
      "match": "/api/sec/v1/scripting",
      "label": "风控脚本下发（无业务数据，建议关闭）"
    },
    {
      "match": "/api/im/web/emoji/config",
      "label": "表情包配置，单条可达 700 KB（无业务数据，建议关闭）"
    },
    {
      "match": "/api/sns/web/v2/comment/sub/page",
      "label": "展开回复（楼中楼，已内置解析）"
    }
  ],
  "notes": "接口在 edith.xiaohongshu.com。评论在笔记详情页展开评论、翻页时触发；IM 相关接口很杂，表情包配置单条 700 KB，建议关注列表只留 feed 和 comment/page。"
}