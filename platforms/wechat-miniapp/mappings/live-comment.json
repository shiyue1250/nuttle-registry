{
  "apiVersion": 1,
  "id": "wechat-miniapp/live-comment",
  "version": "0.1.0",
  "platform": "wechat-miniapp",
  "entity": "live_comment",
  "match": {
    "host": "live.work.weixin.qq.com",
    "path": "/nuttle/wecomlive/Comments"
  },
  "item_path": "comments",
  "fields": {
    "id": "id",
    "live_id": "liveId",
    "seq": "seq",
    "nickname": "nickname",
    "user_id": "username",
    "content": "content",
    "identity": "identity",
    "create_time": "ts",
    "offset": "offset"
  },
  "schema": {
    "create_time": {
      "type": "unix_s",
      "note": "收到这条的时间（直播消息本身不带时间），和真实发言差一两秒"
    },
    "seq": {
      "type": "string",
      "note": "直播间里的消息序号，按它排就是发言顺序"
    },
    "identity": {
      "type": "int",
      "note": "3 = 主播或场控（页面上标「主播」，常用来打商品卖点、价格）；1、2 = 观众"
    },
    "live_id": {
      "type": "string",
      "note": "哪一场直播；口播转文字（weixin/live-speech）用同一个编号"
    },
    "offset": {
      "type": "duration_s",
      "note": "在这场录音里的位置（秒），和口播的 offset 同一把尺子；记录 M095 起才有"
    }
  },
  "trigger": "处理企业微信回放时，按本人观看请求分页整理历史评论",
  "fixture": "live-comment.fixture.json",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "企业微信直播评论",
      "description": "本人观看的回放中平台实际返回的历史评论，按时间关联同一场回放"
    },
    "en": {
      "name": "WeCom live comments",
      "description": "Historical comments available in the replay you watch"
    }
  },
  "jsonld": {
    "@type": "Comment",
    "map": {
      "content": "text",
      "create_time": "dateCreated",
      "nickname": "author"
    }
  },
  "display": {
    "columns": [
      "content",
      "nickname",
      "identity",
      "create_time",
      "live_id"
    ],
    "labels": {
      "zh": {
        "content": "评论",
        "nickname": "评论者",
        "identity": "身份",
        "create_time": "时间",
        "live_id": "直播编号"
      },
      "en": {
        "content": "Comment",
        "nickname": "By",
        "identity": "Role",
        "create_time": "Time",
        "live_id": "Live id"
      }
    }
  },
  "relations": {
    "parent": {
      "card": "wechat-miniapp/live",
      "field": "live_id"
    },
    "order": "seq"
  }
}
