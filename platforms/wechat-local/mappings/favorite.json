{
  "apiVersion": 1,
  "id": "wechat-local/favorite",
  "version": "0.1.0",
  "platform": "wechat-local",
  "entity": "favorite",
  "match": {
    "host": "wechat.local",
    "path": "/nuttle/wechat-local/favorites"
  },
  "item_path": "favorites",
  "fields": {
    "id": "id",
    "kind_label": "kind_label",
    "type_num": "type_num",
    "create_time": "create_time",
    "title": "title",
    "content": "content",
    "url": "url",
    "source": "source"
  },
  "schema": {
    "create_time": {
      "type": "unix_s"
    },
    "type_num": {
      "type": "int",
      "note": "原始类型号"
    },
    "content": {
      "type": "string",
      "note": "正文纯文本（截断到 4000 字）"
    },
    "url": {
      "type": "url",
      "note": "链接类的原文地址"
    }
  },
  "trigger": "在设置里开启「微信收藏 / 文件传输助手」并点同步（仅 Windows，微信需登录运行）",
  "note": "favorite.db / fav_db_item，本机只读解密",
  "fixture": "favorite.fixture.json",
  "verified": "2026-10-07",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "微信收藏",
      "description": "收藏的文章、链接、文件、图片、视频、名片：标题、类型、时间、来源、链接"
    },
    "en": {
      "name": "WeChat Favorites",
      "description": "Saved articles, links, files, images, videos, cards: title, type, time, source, link"
    }
  },
  "display": {
    "columns": [
      "kind_label",
      "title",
      "source",
      "create_time"
    ],
    "labels": {
      "zh": {
        "kind_label": "类型",
        "title": "标题",
        "source": "来源",
        "create_time": "收藏时间"
      },
      "en": {
        "kind_label": "Type",
        "title": "Title",
        "source": "From",
        "create_time": "Saved"
      }
    }
  }
}
