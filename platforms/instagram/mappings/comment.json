{
  "apiVersion": 1,
  "id": "instagram/comment",
  "version": "0.1.0",
  "platform": "instagram",
  "entity": "comment",
  "match": {
    "host": "instagram.com",
    "path": "/nuttle/instagram/comments"
  },
  "item_path": "comments",
  "fields": {
    "id": "id",
    "post_id": "post_id",
    "content": "content",
    "nickname": "author",
    "author": "author",
    "author_id": "author_id",
    "head": "head",
    "create_time": "create_time",
    "like_count": "like_count",
    "reply_count": "reply_count",
    "reply_to": "reply_to"
  },
  "schema": {
    "create_time": {
      "type": "unix_s"
    },
    "like_count": {
      "type": "int"
    },
    "view_count": {
      "type": "int"
    },
    "comment_count": {
      "type": "int"
    },
    "reply_count": {
      "type": "int"
    },
    "duration_s": {
      "type": "duration_s"
    },
    "cover": {
      "type": "image"
    },
    "url": {
      "type": "url"
    },
    "post_id": {
      "type": "string",
      "note": "对应「Instagram 帖子」的 id（短码，取自评论所在页面地址）"
    },
    "reply_to": {
      "type": "string",
      "note": "回复的那条评论 id；一级评论为 \"0\""
    }
  },
  "trigger": "打开帖子或 Reels 的评论、展开回复。需要「Instagram 帖子与评论」插件",
  "note": "数据来自「Instagram 帖子与评论」插件的整理（经本机代理），不是网站原始接口；字段依据开源实现与官方插件样本，还没有用真实浏览采到的数据核对过",
  "fixture": "comment.fixture.json",
  "verified": "2026-10-20",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "Instagram 评论",
      "description": "看过的帖子下的评论与回复：内容、用户、时间、点赞"
    },
    "en": {
      "name": "Instagram comments",
      "description": "Comments and replies under posts you view: text, user, time, likes"
    }
  },
  "display": {
    "columns": [
      "nickname",
      "content",
      "create_time",
      "like_count",
      "reply_count"
    ],
    "labels": {
      "zh": {
        "nickname": "用户",
        "content": "内容",
        "create_time": "时间",
        "like_count": "点赞",
        "reply_count": "回复"
      },
      "en": {
        "nickname": "User",
        "content": "Text",
        "create_time": "Time",
        "like_count": "Likes",
        "reply_count": "Replies"
      }
    }
  },
  "relations": {
    "parent": {
      "card": "instagram/post",
      "field": "post_id"
    },
    "reply_to": "reply_to"
  }
}
