{
  "apiVersion": 1,
  "id": "x/post",
  "version": "0.1.0",
  "platform": "x",
  "entity": "post",
  "match": {
    "host": "x.com",
    "path": "/nuttle/x/posts"
  },
  "item_path": "posts",
  "fields": {
    "id": "id",
    "title": "text",
    "author": "author",
    "handle": "handle",
    "author_id": "author_id",
    "verified": "verified",
    "followers": "followers",
    "create_time": "create_time",
    "view_count": "view_count",
    "like_count": "like_count",
    "retweet_count": "retweet_count",
    "reply_count": "reply_count",
    "quote_count": "quote_count",
    "bookmark_count": "bookmark_count",
    "media_type": "media_type",
    "cover": "cover",
    "duration_s": "duration_s",
    "lang": "lang",
    "url": "url",
    "extra.media_count": "media_count",
    "extra.avatar": "avatar",
    "extra.conversation_id": "conversation_id",
    "extra.quote_of": "quote_of"
  },
  "schema": {
    "create_time": {
      "type": "unix_s"
    },
    "view_count": {
      "type": "int"
    },
    "like_count": {
      "type": "int"
    },
    "retweet_count": {
      "type": "int",
      "note": "转帖"
    },
    "reply_count": {
      "type": "int"
    },
    "quote_count": {
      "type": "int",
      "note": "引用"
    },
    "bookmark_count": {
      "type": "int"
    },
    "followers": {
      "type": "int",
      "note": "作者粉丝数（看到这条帖子时）"
    },
    "cover": {
      "type": "image"
    },
    "duration_s": {
      "type": "duration_s",
      "note": "秒；只有视频有"
    },
    "media_type": {
      "type": "string",
      "note": "video / photo / animated_gif；没有配图为空"
    },
    "verified": {
      "type": "bool",
      "note": "蓝标"
    }
  },
  "trigger": "在浏览器或 X 应用里浏览首页、个人主页、搜索、帖子详情；需要「X」插件 + 「X 帖子与回复」插件",
  "note": "数据来自「X 帖子与回复」插件对 X GraphQL 接口的整理（经本机代理），不是网站原始接口；转发只保留原帖",
  "fixture": "post.fixture.json",
  "verified": "2026-10-05",
  "author": "shiyue1250",
  "license": "MIT",
  "locales": {
    "zh": {
      "name": "X 帖子",
      "description": "浏览过的每条帖子：正文、作者、发布时间、浏览 / 点赞 / 转帖 / 回复 / 引用 / 收藏数、配图与视频"
    },
    "en": {
      "name": "X posts",
      "description": "Every post you view: text, author, time, views / likes / reposts / replies / quotes / bookmarks, images and video"
    }
  },
  "jsonld": {
    "@type": "SocialMediaPosting",
    "map": {
      "title": "articleBody",
      "author": "author",
      "create_time": "datePublished",
      "url": "url"
    }
  },
  "display": {
    "columns": [
      "cover",
      "title",
      "author",
      "create_time",
      "view_count",
      "like_count",
      "retweet_count",
      "reply_count",
      "quote_count",
      "bookmark_count",
      "duration_s",
      "followers"
    ],
    "labels": {
      "zh": {
        "cover": "配图",
        "title": "正文",
        "author": "作者",
        "create_time": "发布时间",
        "view_count": "浏览",
        "like_count": "点赞",
        "retweet_count": "转帖",
        "reply_count": "回复",
        "quote_count": "引用",
        "bookmark_count": "收藏",
        "duration_s": "时长",
        "followers": "作者粉丝"
      },
      "en": {
        "cover": "Media",
        "title": "Text",
        "author": "Author",
        "create_time": "Posted",
        "view_count": "Views",
        "like_count": "Likes",
        "retweet_count": "Reposts",
        "reply_count": "Replies",
        "quote_count": "Quotes",
        "bookmark_count": "Bookmarks",
        "duration_s": "Duration",
        "followers": "Followers"
      }
    }
  },
  "resource": {
    "plugin": "official.x",
    "match": {
      "meta:x.tweetId": "id"
    }
  }
}