{
  "apiVersion": 1,
  "id": "tiktok/comment",
  "version": "0.1.1",
  "platform": "tiktok",
  "entity": "comment",
  "match": {
    "host": "tiktok.com",
    "path": "/api/comment/list/"
  },
  "item_path": "comments",
  "fields": {
    "id": "cid",
    "video_id": "aweme_id",
    "content": "text",
    "create_time": "create_time",
    "like_count": "digg_count",
    "reply_count": "reply_comment_total",
    "nickname": "user.nickname",
    "author": "user.nickname",
    "author_id": "user.unique_id",
    "head": "user.avatar_thumb.url_list.0",
    "reply_to": "reply_id",
    "image": "image_list.0.crop_url.url_list.0",
    "extra.image_list": "image_list",
    "extra.language": "comment_language"
  },
  "schema": {
    "create_time": {
      "type": "unix_s"
    },
    "like_count": {
      "type": "int"
    },
    "reply_count": {
      "type": "int"
    },
    "video_id": {
      "type": "string",
      "note": "对应「TikTok 作品」的 id"
    },
    "reply_to": {
      "type": "string",
      "note": "回复里是所在一级评论的 cid；一级评论为 \"0\""
    },
    "image": {
      "type": "image",
      "note": "评论里的配图（TikTok 一条评论只能带一张）"
    }
  },
  "trigger": "打开作品的评论区、往下翻、展开回复（/api/comment/list/ 与 /api/comment/list/reply/）",
  "fixture": "comment.fixture.json",
  "verified": "2026-10-28",
  "author": "shiyue1250",
  "license": "MIT",
  "note": "字段依据 2026-10-28 用 Chrome 实际浏览 TikTok 网页采到的返回核对；样本是按这些路径构造的示例值",
  "locales": {
    "zh": {
      "name": "TikTok 评论",
      "description": "看过的作品下的评论与回复：内容、用户、时间、点赞"
    },
    "en": {
      "name": "TikTok comments",
      "description": "Comments and replies under videos you watch: text, user, time, likes"
    }
  },
  "jsonld": {
    "@type": "Comment",
    "map": {
      "content": "text",
      "nickname": "author",
      "create_time": "dateCreated"
    }
  },
  "display": {
    "columns": [
      "nickname",
      "content",
      "create_time",
      "like_count",
      "reply_count"
    ],
    "labels": {
      "zh": {
        "nickname": "用户",
        "content": "内容",
        "create_time": "时间",
        "like_count": "点赞",
        "reply_count": "回复"
      },
      "en": {
        "nickname": "User",
        "content": "Text",
        "create_time": "Time",
        "like_count": "Likes",
        "reply_count": "Replies"
      }
    }
  },
  "relations": {
    "parent": {
      "card": "tiktok/video",
      "field": "video_id",
      "count_field": "comment_count"
    },
    "reply_to": "reply_to"
  }
}
