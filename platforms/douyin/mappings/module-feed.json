{
  "apiVersion": 1,
  "id": "douyin/module-feed",
  "version": "0.1.0",
  "platform": "douyin",
  "entity": "video",
  "match": {
    "host": "douyin.com",
    "path": "/aweme/v2/web/module/feed/"
  },
  "item_path": "aweme_list",
  "fields": {
    "id": "aweme_id",
    "title": "desc",
    "author": "author.nickname",
    "author_id": "author.uid",
    "create_time": "create_time",
    "like_count": "statistics.digg_count",
    "comment_count": "statistics.comment_count",
    "collect_count": "statistics.collect_count",
    "share_count": "statistics.share_count",
    "cover": "video.cover.url_list.0",
    "duration_s": "video.duration/1000",
    "ip_location": "ip_label",
    "url": "=https://www.douyin.com/video/{aweme_id}",
    "extra.sec_uid": "author.sec_uid",
    "extra.images": "images"
  },
  "schema": {
    "create_time": {
      "type": "unix_s"
    },
    "like_count": {
      "type": "int",
      "note": "点赞"
    },
    "comment_count": {
      "type": "int"
    },
    "collect_count": {
      "type": "int",
      "note": "收藏"
    },
    "share_count": {
      "type": "int"
    },
    "cover": {
      "type": "image"
    },
    "duration_s": {
      "type": "duration_s",
      "note": "接口是毫秒，/1000 后为秒；图文作品为 0"
    },
    "url": {
      "type": "url"
    }
  },
  "trigger": "刷首页「精选」",
  "fixture": "module-feed.fixture.json",
  "verified": "2026-10-29",
  "author": "nuttle-mac",
  "license": "MIT",
  "note": "2026-10-29 Mac 实测：网页版首页「精选」走 /aweme/v2/web/module/feed/（module_id=3003101），条目结构与 tab/feed 相同。不取 aweme_type：列表里夹的 aweme_type 101 条目（直播 / 推广位）除 id 外全空，不取它这类条目就因「自己的字段全空」不入库。样本按真实返回的结构构造，内容是示例值",
  "locales": {
    "zh": {
      "name": "抖音精选",
      "description": "首页「精选」里刷到的作品"
    },
    "en": {
      "name": "Douyin picks",
      "description": "Posts in the home Picks feed"
    }
  },
  "jsonld": {
    "@type": "VideoObject",
    "map": {
      "title": "description",
      "cover": "thumbnailUrl",
      "create_time": "uploadDate",
      "url": "url"
    }
  },
  "display": {
    "columns": [
      "cover",
      "title",
      "author",
      "create_time",
      "duration_s",
      "like_count",
      "comment_count",
      "collect_count",
      "share_count"
    ],
    "labels": {
      "zh": {
        "cover": "封面",
        "title": "描述",
        "author": "作者",
        "create_time": "发布时间",
        "duration_s": "时长",
        "like_count": "点赞",
        "comment_count": "评论",
        "collect_count": "收藏",
        "share_count": "分享"
      },
      "en": {
        "cover": "Cover",
        "title": "Caption",
        "author": "Author",
        "create_time": "Posted",
        "duration_s": "Duration",
        "like_count": "Likes",
        "comment_count": "Comments",
        "collect_count": "Saves",
        "share_count": "Shares"
      }
    }
  },
  "resource": {
    "plugin": "official.douyin",
    "match": {
      "meta:awemeId": "id"
    }
  }
}
