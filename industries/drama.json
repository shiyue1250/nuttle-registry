{
  "apiVersion": 1,
  "id": "drama",
  "version": "1.0.0",
  "name": { "zh": "短剧工作台", "en": "Short drama" },
  "desc": { "zh": "对标、评论需求、先接哪几处", "en": "Benchmarks, comment asks, sources to connect" },
  "nav": {
    "navOv": { "zh": "工作台", "en": "Workbench" },
    "navKb": { "zh": "打法库", "en": "Playbook" },
    "navPr": { "zh": "素材库", "en": "Library" },
    "navMk": { "zh": "数据源", "en": "Sources" }
  },
  "sources": [
    { "platform": "weixin", "part": "channels", "why": { "zh": "刷广场找对标、看评论", "en": "Benchmarks and comments on Channels" } },
    { "platform": "douyin", "part": "videos", "why": { "zh": "国内短剧、漫剧对标", "en": "Domestic drama benchmarks" } },
    { "platform": "tiktok", "part": "videos", "why": { "zh": "海外短剧", "en": "Overseas short drama" } }
  ],
  "cards": [
    {
      "id": "rising",
      "title": { "zh": "最近起量的对标", "en": "Rising benchmarks" },
      "sub": { "zh": "你最近 3 天刷到的视频，按点赞排", "en": "Videos you saw in the last 3 days, by likes" },
      "from": [{ "platform": "weixin", "kind": "video" }, { "platform": "douyin", "kind": "video" }, { "platform": "tiktok", "kind": "video" }],
      "days": 3,
      "sort": ["like_count"],
      "limit": 5,
      "empty": { "zh": "接上视频号或抖音，刷到的视频会按点赞列在这里。", "en": "Connect Channels or Douyin; the videos you watch show up here by likes.", "platform": "weixin" }
    },
    {
      "id": "asks",
      "title": { "zh": "评论里的需求", "en": "What comments ask for" },
      "sub": { "zh": "评论里问「链接 / 全集 / 什么工具」的", "en": "Comments asking for links, full series or tools" },
      "from": [{ "platform": "weixin", "kind": "comment" }, { "platform": "douyin", "kind": "comment" }, { "platform": "tiktok", "kind": "comment" }],
      "days": 7,
      "match": ["链接", "全集", "哪里看", "在哪看", "下一集", "什么工具", "什么软件", "link", "full series", "full episode", "where can i watch", "what app"],
      "sort": ["like_count"],
      "limit": 5,
      "empty": { "zh": "打开视频看评论，问链接、问全集的评论会出现在这里。", "en": "Open videos and read comments; ones asking for links or the full series appear here." }
    },
    {
      "id": "overseas",
      "title": { "zh": "海外短剧", "en": "Overseas drama" },
      "sub": { "zh": "TikTok 上最近刷到的视频，按播放排", "en": "Recent TikTok videos, by views" },
      "from": [{ "platform": "tiktok", "kind": "video" }],
      "days": 7,
      "sort": ["view_count", "like_count"],
      "limit": 5,
      "empty": { "zh": "接上 TikTok，浏览短剧视频后这里就会列出来。", "en": "Connect TikTok and browse; drama videos show up here.", "platform": "tiktok" }
    }
  ]
}
