{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/shiyue1250/nuttle-registry/schema/platform.schema.json",
  "title": "Nuttle 平台包 v1 / Nuttle Platform Pack v1",
  "description": "一个网站的平台包：适用域名、接口用途标注、建议关注与噪音接口。纯数据。 / A website pack: domains, endpoint labels, suggested and noisy endpoints. Pure data.",
  "type": "object",
  "required": [
    "id",
    "version",
    "label",
    "hosts"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "包 id；社区包不能与官方包重名 / Pack id; community packs must not reuse an official id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "社区包须与 Release 标签一致（可带 v 前缀）/ Must equal the release tag for community packs"
    },
    "label": {
      "type": "string"
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "en": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\*\\.)?[a-z0-9.-]+$"
      },
      "description": "适用域名，*. 前缀匹配所有子域；由插件采集或本机导入的包可为空 / Domains; *. matches all subdomains. May be empty for packs fed by a plugin or a local import"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "watches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "noise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "match": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "locales": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "connector": {
      "type": "object",
      "description": "可选：基座连接器的品牌参数（执行方案 10-接入分层）。kind 选连接器，其余是它的参数；imap 用 providers（各家服务商：id、name、domains 地址后缀、host、port、help、secret_label 凭据那一栏叫什么）与默认 folders；classify 是邮件分类规则（从上往下第一条条件全满足的定类型；没有条件的规则总是满足，放最后做兜底；都不满足是往来信 personal）。 / Optional: brand parameters for a built-in protocol connector; kind picks it, the rest are its parameters (imap: providers [{id, name, domains, host, port, help, secret_label}] and default folders; classify: ordered mail classification rules, first rule whose conditions all hold sets the category, otherwise personal).",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "imap",
            "folder",
            "http"
          ]
        },
        "label": {
          "type": "string",
          "description": "http：模块里显示的名字 / http: name shown on the module"
        },
        "help": {
          "type": "string",
          "description": "http：填之前给用户看的说明（取什么、多久一次、要不要登录）/ http: what it fetches, how often, whether it needs a key"
        },
        "inputs": {
          "type": "array",
          "description": "http：要用户填的值，在请求地址里写成 {id}；list = 可填多个（每个值一个地址），chars: word = 只许字母数字下划线连字符，max = 最长几个字 / http: values the user fills in, used as {id} in request URLs",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "type": "string" },
              "placeholder": { "type": "string" },
              "list": { "type": "boolean" },
              "chars": { "enum": ["word"] },
              "max": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "requests": {
          "type": "array",
          "description": "http：只发 GET；url 里的 {id} 换成输入；every 秒（至少 600）一次；page 分页：param 参数名，next 下一页游标的路径（取不到就停）或 start 起始页码 + items 列表路径（空了就停），max 最多几页（≤ 10）。响应按真实地址入库，由本包映射卡解析 / http: GET only; responses are stored under their real URL and parsed by this pack's cards",
          "items": {
            "type": "object",
            "required": ["id", "url"],
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string", "pattern": "^https?://" },
              "every": { "type": "integer", "minimum": 600 },
              "page": {
                "type": "object",
                "properties": {
                  "param": { "type": "string" },
                  "next": { "type": "string" },
                  "start": { "type": "integer" },
                  "items": { "type": "string" },
                  "max": { "type": "integer", "minimum": 1, "maximum": 10 }
                }
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "description": "http：要密钥时写；密钥由用户填、只存系统凭据管理器，只发给请求地址里写死的域名。type: bearer / header（name 是请求头名）/ query（name 是参数名）/ oauth_client（OAuth2 client credentials：id_input 指哪个输入是应用 id，密钥是应用密钥，向 token_url 换令牌后按 bearer 带）；label 是那一栏叫什么 / http: the key the user enters, kept in the system keychain and sent only to hosts written literally in request URLs",
          "required": ["type", "label"],
          "properties": {
            "type": { "enum": ["bearer", "header", "query", "oauth_client"] },
            "name": { "type": "string" },
            "token_url": { "type": "string", "pattern": "^https://" },
            "id_input": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "rate": {
          "type": "object",
          "description": "http：两次请求之间至少隔多少毫秒（默认 1000）/ http: minimum gap between requests",
          "properties": {
            "min_interval_ms": { "type": "integer", "minimum": 200 }
          }
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "host"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "help": {
                "type": "string"
              },
              "secret_label": {
                "type": "string"
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "classify": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category"
            ],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "personal",
                  "notification",
                  "subscription",
                  "ad"
                ]
              },
              "subject": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "主题含其中任一（不分大小写）"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "发件地址含其中任一"
              },
              "precedence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "信头 Precedence 是其中之一"
              },
              "list": {
                "type": "boolean",
                "description": "有 List-Id 或退订链接"
              },
              "auto": {
                "type": "boolean",
                "description": "信头 Auto-Submitted 不是 no"
              },
              "answered": {
                "type": "boolean",
                "description": "用户回过这封"
              },
              "own": {
                "type": "boolean",
                "description": "发件人就是这个账户（自己发的）"
              },
              "known": {
                "type": "boolean",
                "description": "发件人是这个账户写过信的人，或这封在这个账户发过言的会话里"
              },
              "to_me": {
                "type": "boolean",
                "description": "收件人（To）里直接有这个账户"
              }
            }
          }
        }
      }
    }
  }
}
