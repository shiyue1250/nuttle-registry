{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/shiyue1250/nuttle-registry/schema/platform.schema.json",
  "title": "Nuttle 平台包 v1 / Nuttle Platform Pack v1",
  "description": "一个网站的平台包：适用域名、接口用途标注、建议关注与噪音接口。纯数据。 / A website pack: domains, endpoint labels, suggested and noisy endpoints. Pure data.",
  "type": "object",
  "required": [
    "id",
    "version",
    "label",
    "hosts"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "包 id；社区包不能与官方包重名 / Pack id; community packs must not reuse an official id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "社区包须与 Release 标签一致（可带 v 前缀）/ Must equal the release tag for community packs"
    },
    "label": {
      "type": "string"
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "en": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\*\\.)?[a-z0-9.-]+$"
      },
      "description": "适用域名，*. 前缀匹配所有子域；由插件采集或本机导入的包可为空 / Domains; *. matches all subdomains. May be empty for packs fed by a plugin or a local import"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "watches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "noise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "match": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "locales": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "connector": {
      "type": "object",
      "description": "可选：基座连接器的品牌参数（执行方案 10-接入分层）。kind 选连接器，其余是它的参数；imap 用 providers（各家服务商：id、name、domains 地址后缀、host、port、help、secret_label 凭据那一栏叫什么）与默认 folders；classify 是邮件分类规则（从上往下第一条条件全满足的定类型，都不满足是往来信 personal）。 / Optional: brand parameters for a built-in protocol connector; kind picks it, the rest are its parameters (imap: providers [{id, name, domains, host, port, help, secret_label}] and default folders; classify: ordered mail classification rules, first rule whose conditions all hold sets the category, otherwise personal).",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "imap"
          ]
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "host"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "help": {
                "type": "string"
              },
              "secret_label": {
                "type": "string"
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "classify": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category"
            ],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "personal",
                  "notification",
                  "subscription",
                  "ad"
                ]
              },
              "subject": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "主题含其中任一（不分大小写）"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "发件地址含其中任一"
              },
              "precedence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "信头 Precedence 是其中之一"
              },
              "list": {
                "type": "boolean",
                "description": "有 List-Id 或退订链接"
              },
              "auto": {
                "type": "boolean",
                "description": "信头 Auto-Submitted 不是 no"
              },
              "answered": {
                "type": "boolean",
                "description": "用户回过这封"
              },
              "own": {
                "type": "boolean",
                "description": "发件人就是这个账户（自己发的）"
              }
            }
          }
        }
      }
    }
  }
}
