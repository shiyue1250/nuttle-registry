{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuttle.dev/schema/parts-recipe.schema.json",
  "title": "Nuttle parts recipe",
  "description": "How to break one captured item into parts (steps, shots, …), each pointing back to where it came from.",
  "type": "object",
  "required": ["apiVersion", "id", "version", "name", "on", "input", "types", "prompt"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$" },
    "version": { "type": "string" },
    "name": { "$ref": "#/$defs/text" },
    "note": { "type": "string" },
    "on": {
      "type": "object",
      "required": ["media"],
      "additionalProperties": false,
      "properties": { "media": { "enum": ["text", "video", "image"] } }
    },
    "input": { "type": "array", "minItems": 1, "items": { "enum": ["text", "ocr", "frames", "transcript", "comments"] } },
    "types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "cols"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "cols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "zh", "en"],
              "additionalProperties": false,
              "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "zh": { "type": "string" }, "en": { "type": "string" } }
            }
          }
        }
      }
    },
    "prompt": { "$ref": "#/$defs/text" },
    "kinds": {
      "description": "Video recipes: the kinds of video (story / explainer…). A first text-only call says which kind the video is; everything after follows that kind: its shot columns (cols, ids from types.shot), what they mean (rules, put into the prompt at {kind}) and its role words for beats (beats with other words are dropped).",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "hint", "cols", "rules", "zh", "en", "beat"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "hint": { "description": "How to recognise this kind (goes into kindPrompt)", "$ref": "#/$defs/text" },
          "cols": { "description": "Which types.shot columns this kind uses", "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "rules": { "description": "What this kind's shot columns mean (goes into the prompt at {kind})", "$ref": "#/$defs/text" },
          "zh": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "en": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "beat": { "description": "Which of these words mark a turning point (highlighted in the rhythm line)", "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "kindPrompt": { "description": "With kinds: the text-only prompt that picks the kind ({kinds} is replaced by the list)", "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    }
  }
}
