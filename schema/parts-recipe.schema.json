{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuttle.dev/schema/parts-recipe.schema.json",
  "title": "Nuttle parts recipe",
  "description": "How to break one captured item into parts (steps, shots, …), each pointing back to where it came from.",
  "type": "object",
  "required": ["apiVersion", "id", "version", "name", "on", "input", "types", "prompt"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$" },
    "version": { "type": "string" },
    "name": { "$ref": "#/$defs/text" },
    "note": { "type": "string" },
    "on": {
      "type": "object",
      "required": ["media"],
      "additionalProperties": false,
      "properties": { "media": { "enum": ["text", "video", "image"] } }
    },
    "input": { "type": "array", "minItems": 1, "items": { "enum": ["text", "ocr", "frames", "transcript", "comments"] } },
    "types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "cols"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "cols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "zh", "en"],
              "additionalProperties": false,
              "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "zh": { "type": "string" }, "en": { "type": "string" } }
            }
          }
        }
      }
    },
    "prompt": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    }
  }
}
