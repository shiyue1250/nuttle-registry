{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/shiyue1250/nuttle-registry/schema/mapping-card.schema.json",
  "title": "Nuttle 映射卡规范 v1 / Nuttle Mapping Card Spec v1",
  "description": "一个接口到一种实体的提取规则。纯数据，不含代码；只读、被动、不重放请求、不含凭证。规范全文见 SPEC.md。 / One API endpoint → one entity type. Pure data, no code; read-only, passive, never replays requests, never carries credentials. See SPEC.md.",
  "type": "object",
  "required": [
    "id",
    "version",
    "platform",
    "entity",
    "match",
    "item_path",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "integer",
      "const": 1,
      "description": "规范版本。不写视为 1；新卡请写上 / Spec version. Omitted means 1; new cards should set it"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "平台/卡名，仓库内唯一"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "所属平台包目录名"
    },
    "entity": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "产出的实体类型：comment / note / product / variation …"
    },
    "match": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "域名子串，可省略"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "路径子串"
        }
      }
    },
    "item_path": {
      "type": "string",
      "description": "从响应根到数组的点号路径；响应本身是数组则为空串；`*` 段取对象或数组的每个值（如 note.noteDetailMap.*.note）"
    },
    "fields": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "目标字段 -> 源路径。extra. 前缀整块保留原值；源路径写 $path / $host 取请求上下文（响应正文之外唯一能引用的东西）"
    },
    "schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "int",
              "float",
              "bool",
              "unix_s",
              "unix_ms",
              "url",
              "json",
              "image",
              "duration_s"
            ]
          },
          "unit": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "v1 只作文档，不做强制转换"
    },
    "fixture": {
      "type": "string",
      "description": "同目录下的样本文件名，发布时必填"
    },
    "verified": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "description": "人在页面上做什么会触发这个接口"
    },
    "pagination": {
      "type": "object",
      "properties": {
        "has_more": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "noise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "en": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      },
      "description": "卡的中英文名称与说明 / Localized name and description"
    },
    "jsonld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "@type"
      ],
      "properties": {
        "@type": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z]+$",
          "description": "产出实体对应的 schema.org 类型，例如 Comment、Product、Review / schema.org type of the produced entity"
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "实体字段 → schema.org 属性，例如 content→text / entity field → schema.org property"
        }
      },
      "description": "按 schema.org 词汇以 JSON-LD 输出时的类型与字段对应 / How the entity maps to schema.org for JSON-LD output"
    },
    "display": {
      "type": "object",
      "description": "Table layout for hosts: ordered columns and zh/en column labels",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "description": "How entities of this card hang under a parent entity (e.g. comments under a video) and how replies are nested",
      "properties": {
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "card",
            "field"
          ],
          "properties": {
            "card": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "count_field": {
              "type": "string"
            }
          }
        },
        "reply_to": {
          "type": "string"
        },
        "replies": {
          "type": "string"
        },
        "reply_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which plugin resource (downloadable media) corresponds to an entity of this card",
      "properties": {
        "plugin": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
